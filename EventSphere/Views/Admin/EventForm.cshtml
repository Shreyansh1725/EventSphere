@model EventSphere.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = Model.EventId == 0 ? "Add Event" : "Edit Event";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow">
            <div class="card-header bg-white">
                <h3 class="text-primary mb-0">@(Model.EventId == 0 ? "Create New Event" : "Edit Event")</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="@(Model.EventId == 0 ? "AddEvent" : "EditEvent")" method="post">
                    @if(Model.EventId != 0) { <input type="hidden" asp-for="EventId" /> }
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="EventName" class="form-label">Event Name</label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">Select Category...</option>
                                @foreach(var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="EventDate" class="form-label">Event Date</label>
                            <input asp-for="EventDate" class="form-control" type="date" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartTime" class="form-label">Start Time</label>
                            <input asp-for="StartTime" class="form-control" type="time" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndTime" class="form-label">End Time</label>
                            <input asp-for="EndTime" class="form-control" type="time" />
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Venue" class="form-label">Venue</label>
                            <input asp-for="Venue" class="form-control" />
                            <span asp-validation-for="Venue" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Organizer" class="form-label">Organizer</label>
                            <input asp-for="Organizer" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label asp-for="MaximumParticipants" class="form-label">Max Participants</label>
                            <input asp-for="MaximumParticipants" class="form-control" type="number" />
                            <span asp-validation-for="MaximumParticipants" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RegistrationDeadline" class="form-label">Reg. Deadline (Optional)</label>
                            <input asp-for="RegistrationDeadline" class="form-control" type="datetime-local" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">Draft</option>
                                <option value="Published">Published</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary px-4">Save Event</button>
                    <a asp-action="Events" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
