@model EventSphere.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="text-primary mb-4">Admin Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Total Events</h5>
                <h2 class="display-5">@Model.TotalEvents</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Published Events</h5>
                <h2 class="display-5">@Model.PublishedEvents</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-info shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Total Students</h5>
                <h2 class="display-5">@Model.TotalStudents</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-warning text-dark shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Registrations</h5>
                <h2 class="display-5">@Model.TotalRegistrations</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-danger shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Upcoming Events</h5>
                <h2 class="display-5">@Model.UpcomingEventsCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card text-white bg-secondary shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Total Attendance</h5>
                <h2 class="display-5">@Model.TotalAttendance</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-white">
                <h5 class="text-primary mb-0">Recent Registrations</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Event</th>
                                <th>Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var r in Model.RecentRegistrations)
                            {
                                <tr>
                                    <td>@r.StudentName</td>
                                    <td>@r.EventName</td>
                                    <td>@r.RegistrationCode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white">
                <a asp-action="Registrations" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-white">
                <h5 class="text-primary mb-0">Upcoming Events</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Seats Left</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var e in Model.UpcomingEvents)
                            {
                                <tr>
                                    <td>@e.EventName</td>
                                    <td>@e.EventDate.ToShortDateString()</td>
                                    <td>@e.AvailableSeats</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white">
                <a asp-action="Events" class="btn btn-sm btn-outline-primary">Manage Events</a>
            </div>
        </div>
    </div>
</div>
