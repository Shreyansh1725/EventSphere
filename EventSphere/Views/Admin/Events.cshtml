@model IEnumerable<EventSphere.Models.Event>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary mb-0">Manage Events</h2>
    <a asp-action="AddEvent" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Event</a>
</div>

<div class="card shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Seats</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model)
                    {
                        <tr>
                            <td>@evt.EventName</td>
                            <td>@evt.CategoryName</td>
                            <td>@evt.EventDate.ToShortDateString()</td>
                            <td>@evt.Venue</td>
                            <td>@evt.AvailableSeats / @evt.MaximumParticipants</td>
                            <td>
                                @if (evt.Status == "Published")
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else if (evt.Status == "Draft")
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@evt.Status</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditEvent" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    
                                    @if (evt.Status == "Draft")
                                    {
                                        <a asp-action="ToggleEventStatus" asp-route-id="@evt.EventId" asp-route-status="Published" class="btn btn-sm btn-outline-success">Publish</a>
                                    }
                                    else if (evt.Status == "Published")
                                    {
                                        <a asp-action="ToggleEventStatus" asp-route-id="@evt.EventId" asp-route-status="Cancelled" class="btn btn-sm btn-outline-warning">Cancel</a>
                                    }
                                    
                                    <form asp-action="DeleteEvent" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <input type="hidden" name="id" value="@evt.EventId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
