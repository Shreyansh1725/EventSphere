@model EventSphere.Models.Event
@{
    ViewData["Title"] = Model.EventName;
    bool isRegistered = ViewBag.IsAlreadyRegistered ?? false;
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow border-0 mb-4">
            <div class="card-body p-5">
                <span class="badge bg-info text-dark mb-2">@Model.CategoryName</span>
                <h1 class="display-5 fw-bold text-primary mb-4">@Model.EventName</h1>
                
                <h5 class="fw-bold mb-3">About this event</h5>
                <p class="lead" style="white-space: pre-wrap;">@Model.Description</p>
                
                <div class="row mt-5">
                    <div class="col-sm-6 mb-4">
                        <h6 class="text-muted text-uppercase fw-bold">Date and Time</h6>
                        <p class="mb-0 fs-5"><i class="bi bi-calendar-event me-2"></i>@Model.EventDate.ToString("dddd, MMMM dd, yyyy")</p>
                        <p class="text-muted">@(Model.StartTime?.ToString(@"hh\:mm")) to @(Model.EndTime?.ToString(@"hh\:mm"))</p>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <h6 class="text-muted text-uppercase fw-bold">Location</h6>
                        <p class="mb-0 fs-5"><i class="bi bi-geo-alt me-2"></i>@Model.Venue</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow border-0 sticky-top" style="top: 20px;">
            <div class="card-body p-4 text-center">
                <h4 class="mb-4">Registration</h4>
                
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Status</span>
                    @if (Model.Status == "Published")
                    {
                        <span class="badge bg-success">Open</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Closed</span>
                    }
                </div>
                
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Available Seats</span>
                    <span class="fw-bold">@Model.AvailableSeats / @Model.MaximumParticipants</span>
                </div>
                
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Deadline</span>
                    <span class="fw-bold text-danger">@(Model.RegistrationDeadline?.ToString("MMM dd, yyyy") ?? "N/A")</span>
                </div>
                
                <hr />
                
                @if (isRegistered)
                {
                    <div class="alert alert-success mt-4">
                        <i class="bi bi-check-circle-fill me-2"></i>You are registered for this event.
                    </div>
                    <a asp-controller="Student" asp-action="MyEvents" class="btn btn-outline-success w-100 mt-2">View My Events</a>
                }
                else if (Model.Status != "Published")
                {
                    <button class="btn btn-secondary btn-lg w-100 mt-3" disabled>Registration Closed</button>
                }
                else if (Model.AvailableSeats <= 0)
                {
                    <button class="btn btn-danger btn-lg w-100 mt-3" disabled>Event Full</button>
                }
                else if (Model.RegistrationDeadline.HasValue && Model.RegistrationDeadline < DateTime.Now)
                {
                    <button class="btn btn-secondary btn-lg w-100 mt-3" disabled>Deadline Passed</button>
                }
                else
                {
                    if (isLoggedIn)
                    {
                        <a asp-action="Register" asp-route-id="@Model.EventId" class="btn btn-primary btn-lg w-100 mt-3">Register Now</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Events/Register/@Model.EventId" class="btn btn-primary btn-lg w-100 mt-3">Login to Register</a>
                    }
                }
            </div>
        </div>
    </div>
</div>
