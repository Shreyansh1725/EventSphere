@model EventSphere.Models.Event
@{
    ViewData["Title"] = "Confirm Registration";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <h2 class="text-primary text-center mb-4">Confirm Registration</h2>
                
                <div class="alert alert-info">
                    You are about to register for the following event:
                </div>
                
                <div class="mb-4">
                    <h4>@Model.EventName</h4>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2"><strong>Date:</strong> @Model.EventDate.ToString("MMMM dd, yyyy")</li>
                        <li class="mb-2"><strong>Time:</strong> @(Model.StartTime?.ToString(@"hh\:mm")) - @(Model.EndTime?.ToString(@"hh\:mm"))</li>
                        <li class="mb-2"><strong>Venue:</strong> @Model.Venue</li>
                    </ul>
                </div>
                
                <form asp-action="Register" method="post">
                    <input type="hidden" name="id" value="@Model.EventId" />
                    <input type="hidden" name="confirm" value="true" />
                    
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            I confirm my participation in this event and agree to follow all guidelines.
                        </label>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5">Confirm Registration</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
