@model IEnumerable<EventSphere.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h2 class="text-primary mb-4">Notifications</h2>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow">
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="p-4 text-center text-muted">No notifications found.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            <li class="list-group-item p-3 @(n.IsRead ? "" : "bg-light")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-1 text-primary">@n.Title</h5>
                                    <small class="text-muted">@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                                <p class="mb-1">@n.Message</p>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
