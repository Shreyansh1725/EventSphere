@model IEnumerable<EventSphere.Models.Registration>
@{
    ViewData["Title"] = "My Events";
}

<h2 class="text-primary mb-4">My Registered Events</h2>

<div class="card shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Registration ID</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Reg Status</th>
                        <th>Attendance</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center">You have not registered for any events yet.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.RegistrationCode</strong></td>
                            <td>@item.EventName</td>
                            <td>@(item.EventDate?.ToString("MMM dd, yyyy"))</td>
                            <td>@item.Venue</td>
                            <td>
                                @if(item.Status == "Registered") { <span class="badge bg-success">Registered</span> }
                                else { <span class="badge bg-secondary">@item.Status</span> }
                            </td>
                            <td>
                                @if(item.AttendanceStatus == "Present") { <span class="badge bg-success">Present</span> }
                                else if(item.AttendanceStatus == "Absent") { <span class="badge bg-danger">Absent</span> }
                                else { <span class="badge bg-warning text-dark">Pending</span> }
                            </td>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
