@model EventSphere.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = "Request New Event";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow">
            <div class="card-header bg-white">
                <h3 class="text-primary mb-0">Request New Event</h3>
                <p class="text-muted mb-0 small">Submit your event proposal for admin approval.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="RequestEvent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="EventName" class="form-label">Event Name</label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">Select Category...</option>
                                @foreach(var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description & Purpose</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="EventDate" class="form-label">Proposed Date</label>
                            <input asp-for="EventDate" class="form-control" type="date" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartTime" class="form-label">Start Time</label>
                            <input asp-for="StartTime" class="form-control" type="time" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndTime" class="form-label">End Time</label>
                            <input asp-for="EndTime" class="form-control" type="time" />
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Venue" class="form-label">Requested Venue/Room</label>
                            <input asp-for="Venue" class="form-control" />
                            <span asp-validation-for="Venue" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaximumParticipants" class="form-label">Expected Participants</label>
                            <input asp-for="MaximumParticipants" class="form-control" type="number" />
                            <span asp-validation-for="MaximumParticipants" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary px-4">Submit Request</button>
                    <a asp-action="Dashboard" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
